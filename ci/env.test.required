#!/usr/bin/env bash
# OpenShift DPF E2E Test Required Environment Variables
# -------------------------------------------------------
# Source this file to validate that critical variables are set before
# generating the .env.test file. These have no defaults — they must be
# provided in user.env.test.
# Syntax: ${VAR:?message} fails immediately if VAR is unset or empty.

# Management cluster kubeconfig — must be an absolute path.
# Tests are run from the test/ subdirectory, so relative paths will not resolve correctly.
: ${KUBECONFIG:?KUBECONFIG must be set (absolute path to the management cluster kubeconfig)}
