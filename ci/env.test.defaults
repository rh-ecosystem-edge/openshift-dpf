#!/usr/bin/env bash
# OpenShift DPF E2E Test Environment Defaults
# ---------------------------------------------------
# Source this file to set default values for all test configuration variables.
# Variables already set in the environment will NOT be overridden.
# Syntax: ${VAR:-default} means "use default if VAR is unset or empty".
#
# KUBECONFIG has no default — it must be provided in user.env.test.

# HyperShift / hosted cluster identification
HOSTED_CLUSTER_NAME=${HOSTED_CLUSTER_NAME:-doca}
CLUSTERS_NAMESPACE=${CLUSTERS_NAMESPACE:-clusters}

# DPF deployment identification
DPF_NAMESPACE=${DPF_NAMESPACE:-dpf-operator-system}
DPU_CLUSTER_NAME=${DPU_CLUSTER_NAME:-doca}
DPU_DEPLOYMENT_NAME=${DPU_DEPLOYMENT_NAME:-dpudeployment}

# Sanity / connectivity test tuning
SANITY_TESTS_WORKLOAD_NAMESPACE=${SANITY_TESTS_WORKLOAD_NAMESPACE:-workload}
SANITY_TESTS_PING_COUNT=${SANITY_TESTS_PING_COUNT:-20}
SANITY_TESTS_PING_HBN_TO_HBN_PODS=${SANITY_TESTS_PING_HBN_TO_HBN_PODS:-false}

# Node counts
WORKER_COUNT=${WORKER_COUNT:-0}

# Hosted cluster upgrade test (optional — leave empty to skip)
UPGRADE_RELEASE_IMAGE=${UPGRADE_RELEASE_IMAGE:-}

# BFB update test — TC-DPUD-002 (optional — leave empty to skip)
NEW_BFB_URL=${NEW_BFB_URL:-}
NEW_BFB_FILENAME=${NEW_BFB_FILENAME:-}
NEW_BFB_BSP=${NEW_BFB_BSP:-}
NEW_BFB_DOCA=${NEW_BFB_DOCA:-}
NEW_BFB_UEFI=${NEW_BFB_UEFI:-}
NEW_BFB_ATF=${NEW_BFB_ATF:-}
